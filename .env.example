# Sample configuration - copy this to .env and fill in your real values.

# Telegram bot token from @BotFather.
# This is the only required field.
BOT_TOKEN=

# Spotify Client ID and Secret are no longer used by the bot.
# The bot uses Spotify's public embed page which doesn't need auth.
# Leave these empty unless you re-introduce OAuth.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=